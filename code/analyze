rint(\"=== Стратегии модели при генерации ПРОЦЕНТОВ ===\")\n","    print(df_compare['strategy_p'].value_counts(normalize=True).map('{:.1%}'.format))\n","    print(\"\\n=== Стратегии модели при генерации СЛОВ ===\")\n","    print(df_compare['strategy_v'].value_counts(normalize=True).map('{:.1%}'.format))\n","    print(\"\\n\" + \"=\"*60 + \"\\n\")\n","\n","    ct_strategy = pd.crosstab(df_compare['strategy_p'], df_compare['strategy_v'],\n","                               rownames=['Strategy in Percent'], colnames=['Strategy in Verbal'],\n","                               normalize=True)\n","\n","    plt.figure(figsize=(8, 6))\n","    sns.heatmap(ct_strategy, annot=True, fmt='.1%', cmap='Purples', cbar=True,\n","                square=True, linewidths=0.5)\n","\n","    plt.tight_layout()\n","    plt.show()\n","\n","    return df_compare"],"metadata":{"id":"897cs9Oe1DlY"},"execution_count":null,"outputs":[]},{"cell_type":"code","source":["qwen_conflict = compare_conflict(qwen_conf_p, qwen_conf_v)"],"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":922},"id":"Wi982SpXOHuK","executionInfo":{"status":"ok","timestamp":1779929032219,"user_tz":-180,"elapsed":328,"user":{"displayName":"Daria Baranova","userId":"10404245028722286298"}},"outputId":"1b2aad69-52cd-4bf7-8316-a6e0d9b6b4bd"},"execution_count":null,"outputs":[{"output_type":"stream","name":"stdout","text":["=== Стратегии модели при генерации ПРОЦЕНТОВ ===\n","strategy_p\n","Contextual        62.8%\n","Parametric        23.6%\n","None/Other         9.4%\n","Both (Overlap)     4.2%\n","Name: proportion, dtype: object\n","\n","=== Стратегии модели при генерации СЛОВ ===\n","strategy_v\n","Contextual        72.4%\n","Parametric        19.1%\n","Both (Overlap)     4.9%\n","None/Other         3.6%\n","Name: proportion, dtype: object\n","\n","============================================================\n","\n"]},{"output_type":"display_data","data":{"text/plain":["<Figure size 800x600 with 2 Axes>"],"image/