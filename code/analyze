 ).reset_index()\n","\n","    summary_df['Доля_правильных'] = summary_df['Правильных_ответов'] / summary_df['Всего_ответов']\n","\n","    summary_df = summary_df.sort_values(by=['rel_p_id', 'Context_Type']).reset_index(drop=True)\n","\n","    print(f\"\\n============= ОПИСАТЕЛЬНАЯ СТАТИСТИКА ДЛЯ: {model_name} =============\")\n","    print(summary_df.to_string(index=False, formatters={'Доля_правильных': '{:.2%}'.format}))\n","\n","    df_all['Group_Combo'] = df_all['rel_p_id'].astype(str) + \" (\" + df_all['Context_Type'] + \")\"\n","    contingency_table = pd.crosstab(df_all['Group_Combo'], df_all['parametric'])\n","\n","    chi2, p_val, dof, expected = chi2_contingency(contingency_table)\n","    print(f\"\\nРезультаты теста Хи-квадрат для {model_name} (Фактор: Отношение x Контекст):\")\n","    print(f\"Статистика Chi2 = {chi2:.4f}\")\n","    print(f\"p-value = {p_val:.4f}\")\n","\n","    if p_val < 0.05:\n","        print(\"ВЫВОД: Различия STATISTICALLY SIGNIFICANT. Комбинация типа отношений и контекста влияет на точность.\")\n","    else:\n","        print(\"ВЫВОД: Различия НЕЗНАЧИМЫ. Модель ведет себя стабильно независимо от контекста и отношений.\")\n","\n","    plt.figure(figsize=(12, 6))\n","    sns.set_theme(style=\"whitegrid\")\n","\n","    ctx_palette = {'Нейтральный': '#4A90E2', 'Консистентный': '#2ECC71', 'Конфликтный': '#E74C3C'}\n","\n","    ax = sns.barplot(\n","        data=summary_df,\n","        x='rel_p_id',\n","        y='Доля_правильных',\n","        hue='Context_Type',\n","        palette=ctx_palette\n","    )\n","\n","    for p in ax.patches:\n","        height = p.get_height()\n","        if pd.isna(height) or height == 0:\n","            continue\n","        ax.annotate(\n","            f'{height:.0%}',\n","            (p.get_x() + p.get_width() / 2., height),\n","            ha='center',\n","            va='bottom',\n","            fontsize=9,\n","            fontweight='bold',\n","            xytext=(0, 3),\n","            textcoords='offset points'\n","        )\n","\n","    plt.ylabel(\"Доля правильных ответов (Accuracy)\", fontsize=12)\n","    plt.xlabel(\"Тип отношений\", fontsize=12)\n","    plt.ylim(0, 1.15)\n","    plt.legend(title=\"Тип контекста\", loc='lower left')\n","    plt.tight_layout()\n","    plt.show()\n","\n","    return summary_df"],"metadata":{"id":"VrykPN3GGyvq"},"execution_count":null,"outputs":[]},{"cell_type":"code","source":["calculate_relation_accuracy_by_context(qwen_n_p, qwen_n_v, qwen_cons_p, qwen_cons_v, qwen_conf_p, qwen_conf_v, \"Qwen\")"],"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":1000},"id":"vSkHENbnHDt3","executionInfo":{"status":"ok","timestamp":1779900453309,"user_tz":-180,"elapsed":359,"user":{"displayName":"Daria Baranova","userId":"10404245028722286298"}},"outputId":"7309ae85-f2e7-45d4-c901-04885692e737"},"execution_count":null,"outputs":[{"output_type":"stream","name":"stdout","text":["\n","============= ОПИСАТЕЛЬНАЯ СТАТИСТИКА ДЛЯ: Qwen =============\n","rel_p_id  Context_Type  Всего_ответов  Правильных_ответов Доля_правильных\n","   P1376 Консистентный            454                 450          99.12%\n","   P1376   Конфликтный            454                 151          33.26%\n","   P1376   Нейтральный            454                 346          76.21%\n","     P27 Консистентный            428                 426          99.53%\n","     P27   Конфликтный            428                  32           7.48%\n","     P27   Нейтральный            428                 339          79.21%\n","     P30 Консистентный            462                 452          97.84%\n","     P30   Конфликтный            462                 192          41.56%\n","     P30   Нейтральный            462                 401          86.80%\n","     P37 Консистентный            456                 453          99.34%\n","     P37   Конфликтный            456                  91          19.96%\n","     P37   Нейтральный            456                 422      